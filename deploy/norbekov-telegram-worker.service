[Unit]
Description=Norbekov Telegram campaign background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/nm-dashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/nm-dashboard/env/bin/python manage.py process_telegram_campaigns --poll 2
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027

[Install]
WantedBy=multi-user.target
